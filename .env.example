# ==============================================================================
# ECOSISTEMA FLOR MARTÍNEZ - CONFIGURACIÓN DE ENTORNO
# ==============================================================================

# Conexión Centralizada a Base de Datos PostgreSQL (Prisma / Supabase / Neon / RDS)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flor_martinez_ecosystem?schema=public"

# Configuración de Google OAuth (Opcional en modo simulador / Requerido para OAuth nativo)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# URLs del Ecosistema en Producción
NEXT_PUBLIC_SITE_URL="https://flormartinez.com"
NEXT_PUBLIC_ACADEMY_URL="https://academia.flormartinez.com"

# Pasarela de Pagos (Mercado Pago / Stripe)
MERCADOPAGO_ACCESS_TOKEN="TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY="TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
