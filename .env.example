# Base de Datos PostgreSQL Unificada (Supabase / Neon)
# Ejemplo Supabase: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:password@localhost:5432/flor_martinez_ecosystem?schema=public"

# Autenticación y Seguridad SSO
AUTH_SECRET="flor-martinez-super-secret-sso-jwt-key-2025"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_ACADEMY_URL="http://localhost:3001"

# Pasarela de Pagos (Mercado Pago & Stripe)
MP_PUBLIC_KEY="TEST-00000000-0000-0000-0000-000000000000"
MP_ACCESS_TOKEN="TEST-0000000000000000-000000-00000000000000000000000000000000-000000000"
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Emails Transaccionales (Resend)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Flor Martinez <hola@flormartinez.com>"
